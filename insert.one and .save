db.student.find()

db.student.find({ marks: { $gt: 80 } })

db.student.find({
    $and: [
        { marks: { $gt: 70 } },
        { age: { $lt: 22 } }
    ]
})

db.student.updateOne(
    { student_id: 101 },
    { $set: { marks: 90 } }
)

