db.employees.find()

db.employees.aggregate([
{
    $group: {
        _id: "$department",
        total_salary: { $sum: "$salary" },
        minimum_salary: { $min: "$salary" },
        maximum_salary: { $max: "$salary" },
        average_salary: { $avg: "$salary" },
        employee_count: { $sum: 1 },
        employee_names: { $push: "$name" }
    }
}
])

db.employees.aggregate([
{
    $sort: { hire_date: 1 }
},
{
    $group: {
        _id: null,
        first_hired_employee: { $first: "$name" },
        last_hired_employee: { $last: "$name" }
    }
}
])

db.employees.aggregate([
{
    $match: {
        salary: { $gt: 45000 }
    }
},
{
    $project: {
        _id: 0,
        name: 1,
        department: 1,
        salary: 1
    }
},
{
    $sort: {
        salary: -1
    }
}
])

db.employees.createIndex({ name: 1 })

db.employees.getIndexes()
